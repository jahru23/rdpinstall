# ---- runtime ----
RDPINSTALL_ENV=dev                 # dev | prod (prod: cookie Secure, dev login mati)
RDPINSTALL_BIND=127.0.0.1:8791
RDPINSTALL_BASE_URL=https://install.jaystore.top
RDPINSTALL_DB=data/rdpinstall.db

# 32-byte hex. Di produksi WAJIB diisi (openssl rand -hex 32).
# Kalau kosong, dibuat otomatis di RDPINSTALL_KEY_FILE (0600).
RDPINSTALL_MASTER_KEY=
RDPINSTALL_KEY_FILE=keys/master.key

# ---- telegram login widget ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- kebijakan ----
RDPINSTALL_SESSION_TTL_HOURS=720
RDPINSTALL_JOB_TTL_HOURS=24        # kredensial otomatis dihapus setelah ini
RDPINSTALL_PRICE=5000              # tarif per install (rupiah)
RDPINSTALL_DEV_LOGIN=0             # 1 = aktifkan tombol login dev (jangan di prod)

# ---- gateway yang sudah jalan (jangan bikin baru) ----
# Dipakai memanggil gateway (server-ke-server).
PAYGATE_URL=http://127.0.0.1:3001
# Alamat publik gateway: gateway membangun URL QR dari host pemanggil, jadi
# URL loopback ditulis ulang ke alamat ini agar bisa dibuka browser user.
PAYGATE_PUBLIC_URL=https://pg-v1.jaystore.top
PAYGATE_API_KEY=
CRYPTOGATE_URL=http://127.0.0.1:8899
CRYPTOGATE_API_KEY=

RUST_LOG=rdpinstall=info,tower_http=warn
